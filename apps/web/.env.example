# Copy to apps/web/.env.development.local (never commit that file).
#
# Option A, run the web app against the deployed TAKUMI backend:
#   VITE_DEV_API_TARGET=https://takumi-cup-2026.web.app
#   and copy the six Firebase values below from https://takumi-cup-2026.web.app/__/firebase/init.json
#   (Firebase Hosting serves this public web configuration; it is not a secret).
#
# Option B, your own backend: point the targets at your local services and use your Firebase project's web config.
#   VITE_DEV_API_TARGET=http://localhost:8080
#   VITE_DEV_FORGE_TARGET=http://localhost:8081

VITE_DEV_API_TARGET=
VITE_DEV_FORGE_TARGET=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
