{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takumi.dev/schemas/soak_runs.json",
  "title": "SoakRun",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique soak run identifier (soak_...)"
    },
    "created_by": {
      "type": "string",
      "description": "Firebase UID of user who started the soak run"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server timestamp when run started"
    },
    "ended_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Timestamp when run completed or stopped"
    },
    "duration_min": {
      "type": "number",
      "minimum": 0.5,
      "description": "Planned run duration in minutes"
    },
    "schedule_seed": {
      "type": ["integer", "string"],
      "description": "Deterministic seed for state transition schedule"
    },
    "machines": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of machine IDs included in this soak run"
    },
    "status": {
      "type": "string",
      "enum": ["running", "completed", "cancelled"],
      "description": "Current status of the soak run"
    },
    "truth": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SoakTruth"
      },
      "description": "Optional embedded truth entries or subcollection documents"
    }
  },
  "required": [
    "id",
    "created_by",
    "started_at",
    "duration_min",
    "schedule_seed",
    "machines",
    "status"
  ],
  "additionalProperties": false,
  "$defs": {
    "SoakTruth": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "machine_id": { "type": "string" },
        "ts": { "type": "string", "format": "date-time" },
        "run_s": { "type": ["number", "null"], "minimum": 0 },
        "event_type": { "type": "string", "enum": ["state_change", "alarm", "alarm_cleared", "count"] },
        "state": { "type": ["string", "null"] },
        "count": { "type": ["integer", "null"] },
        "alarm_code": { "type": ["string", "null"] }
      },
      "required": ["machine_id", "ts", "run_s", "event_type"],
      "additionalProperties": false
    }
  }
}
