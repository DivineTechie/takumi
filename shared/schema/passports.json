{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takumi.dev/schemas/passports.json",
  "title": "Passport",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unguessable passport ID, pp_ + 16 url-safe chars"
    },
    "trainee_uid": {
      "type": "string"
    },
    "skill_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "session_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verify_url": {
      "type": "string",
      "format": "uri"
    },
    "display_first_name": {
      "type": "string",
      "description": "[ADDED] First name of trainee on certificate"
    },
    "skill_title": {
      "type": "string",
      "description": "[ADDED] Title of the verified skill"
    },
    "master_display_name": {
      "type": "string",
      "description": "[ADDED] Display name of the master instructor"
    },
    "language": {
      "type": "string",
      "description": "[ADDED] Language of the verified sessions"
    },
    "mistakes_last_run": {
      "type": "integer",
      "description": "[ADDED] Mistakes count on final qualifying run"
    },
    "badge_path": {
      "type": ["string", "null"],
      "description": "[ADDED] Cloud Storage path to badge seal image"
    }
  },
  "required": [
    "id",
    "trainee_uid",
    "skill_id",
    "issued_at",
    "session_ids",
    "verify_url",
    "display_first_name",
    "skill_title",
    "master_display_name",
    "language",
    "mistakes_last_run"
  ],
  "additionalProperties": false
}
