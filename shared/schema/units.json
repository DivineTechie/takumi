{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takumi.dev/schemas/units.json",
  "title": "Unit",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "description": "Unit serial number or unique identifier"
    },
    "product_id": {
      "type": "string",
      "description": "Identifier of the product"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "passed",
        "failed",
        "needs_review",
        "on_hold"
      ],
      "description": "Lifecycle state of the unit"
    },
    "station_records": {
      "type": "array",
      "description": "One record per finished Station Watch session on this unit (P16)",
      "items": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "skill_id": {
            "type": "string"
          },
          "station": {
            "type": "string"
          },
          "operator_uid": {
            "type": [
              "string",
              "null"
            ],
            "description": "Shown to supervisors only"
          },
          "status": {
            "type": "string"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "ended_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "steps_total": {
            "type": "integer"
          },
          "steps_done": {
            "type": "integer"
          },
          "incomplete_steps": {
            "type": "array",
            "items": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "mistakes": {
            "type": "integer"
          },
          "safety_stops": {
            "type": "integer"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "step_title": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "type": {
                  "type": "string"
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "t": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "frame_uri": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "inspections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered inspection IDs performed on this unit"
    },
    "created_by": {
      "type": [
        "string",
        "null"
      ],
      "description": "Firebase UID of operator or inspector"
    },
    "holds": {
      "type": "array",
      "description": "Quarantine decisions by supervisors",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string"
          },
          "by_uid": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "traceback",
              "manual"
            ]
          },
          "previous_status": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "released_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "released_by_uid": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "product_id",
    "created_at",
    "status",
    "station_records",
    "inspections"
  ],
  "additionalProperties": false
}
